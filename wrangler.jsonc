{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flotionrecords",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./",
  "kv_namespaces": [
    {
      "binding": "ORDERS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flotion-mastering",
      "database_id": "80accce9-d1d1-401c-a0ee-22696cbf0838"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "flotion-mastering-audio"
    }
  ]
}
